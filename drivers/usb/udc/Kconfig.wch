config UDC_WCH
	bool "WCH USB device controller driver"
	default y
	depends on DT_HAS_WCH_USBFS_ENABLED && UDC_DRIVER
	help
	  WCH USB device controller driver.

config UDC_WCH_STACK_SIZE
	int "UDC controller driver internal thread stack size"
	depends on UDC_WCH
	default 512
	help
	  WCH USB device controller driver internal thread stack size.

config UDC_WCH_THREAD_PRIORITY
	int "WCH USB controller driver thread priority"
	depends on UDC_WCH
	default 8
	help
	  WCH USB device controller driver thread priority.

config UDC_WCH_MAX_QMESSAGES
	int "WCH UDC driver maximum number of ISR event messages"
	range 4 64
	default 8
	help
	  Maximum number of messages for handling of WCH USBD ISR events.

config UDC_WCH_X03X
	bool "WCH CH32X035 USBFS device controller driver"
	default y
	depends on DT_HAS_WCH_CH32X035_USBFS_ENABLED && UDC_DRIVER
	help
	  device-next (udc_api) driver for the CH32X03x USBFS device
	  controller.

config UDC_WCH_X03X_STACK_SIZE
	int "CH32X035 UDC driver internal thread stack size"
	depends on UDC_WCH_X03X
	default 512
	help
	  CH32X035 USBFS device controller driver internal thread stack size.

config UDC_WCH_X03X_THREAD_PRIORITY
	int "CH32X035 UDC controller driver thread priority"
	depends on UDC_WCH_X03X
	default 8
	help
	  CH32X035 USBFS device controller driver thread priority.

config UDC_WCH_X03X_MAX_QMESSAGES
	int "CH32X035 UDC driver maximum number of ISR event messages"
	depends on UDC_WCH_X03X
	range 4 64
	default 8
	help
	  Maximum number of messages for handling of CH32X035 USBFS ISR events.
